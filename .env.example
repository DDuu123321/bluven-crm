# ---------- Database ----------
DATABASE_URL="postgresql://bluven:bluven@127.0.0.1:5432/bluven_dev"
# Used by the automated tests only
DATABASE_URL_TEST="postgresql://bluven:bluven@127.0.0.1:5432/bluven_test"

# ---------- Application ----------
# Public base URL of the CRM, no trailing slash. Used in notification links and same-origin checks.
APP_URL="http://localhost:3000"
# Business time zone used for displaying dates and for date-only fields
APP_TIMEZONE="Australia/Sydney"
# Directory where uploaded files are stored
STORAGE_DIR="./data/storage"
# Maximum size of a single uploaded file, in megabytes
MAX_UPLOAD_MB="500"

# ---------- First admin account (used by `pnpm db:seed`) ----------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_NAME="Admin"
SEED_ADMIN_PASSWORD="change-me-please"

# ---------- Leads from the Bluven website (optional) ----------
# The worker collects new leads from the website's CMS once a minute. The key must equal
# CRM_SYNC_KEY on the CMS. Leave empty to switch this off.
# Production: BLUVEN_LEADS_URL="https://cms.bluven.com.au/api/crm/leads"
BLUVEN_LEADS_URL=""
BLUVEN_LEADS_KEY=""
# First run only: also take over leads created since this time, as history. Example: 2026-07-01T00:00:00+10:00
BLUVEN_LEADS_SINCE=""

# ---------- Notification emails (optional) ----------
# Leave everything empty to disable outgoing notification emails.
# Through an HTTPS mail relay (the Bluven website runs one at /api/send-mail), for hosts that
# block outgoing SMTP. When set, it is used instead of SMTP.
MAIL_RELAY_URL=""
MAIL_RELAY_KEY=""
# Or directly by SMTP. Example: smtps://user:password@smtp.zoho.com.au:465
SMTP_URL=""
MAIL_FROM="Bluven CRM <crm@example.com>"

# ---------- Pylon (optional) ----------
PYLON_API_TOKEN=""
PYLON_WEBHOOK_SECRET=""
PYLON_API_BASE="https://api.getpylon.com"
