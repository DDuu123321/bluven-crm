{
  "name": "bluven-crm",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @bluven/web dev",
    "dev:worker": "pnpm --filter @bluven/worker dev",
    "build": "pnpm --filter @bluven/web build",
    "start": "pnpm --filter @bluven/web start",
    "start:worker": "pnpm --filter @bluven/worker start",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @bluven/web lint",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "e2e": "pnpm --filter @bluven/e2e test",
    "db:generate": "pnpm --filter @bluven/db generate",
    "db:migrate": "pnpm --filter @bluven/db migrate:dev",
    "db:deploy": "pnpm --filter @bluven/db migrate:deploy",
    "db:seed": "pnpm --filter @bluven/db seed"
  }
}
