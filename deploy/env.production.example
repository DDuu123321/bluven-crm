# Settings for the Docker Compose setup on your own server.
# Copy to ".env" next to docker-compose.yml on the server and fill in the values.
# Never commit the filled-in file.
# (On Railway there is no file: the same names go into the service's Variables. See docs/deployment-guide.md.)

# The address people will use, without https://. Its DNS record must point at this server
# before the first start so that the HTTPS certificate can be issued.
CRM_DOMAIN=crm.bluven.com.au

# Database password. Letters and digits only, because it is used inside a URL.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Business time zone for dates on screen and for date-only fields.
APP_TIMEZONE=Australia/Sydney

# Largest single file that can be uploaded, in megabytes.
MAX_UPLOAD_MB=500

# First administrator. Created on the first start only, when no user exists yet.
# You will be asked to choose a new password at first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# Leads from the Bluven website. The CRM collects them once a minute from the website's CMS.
# BLUVEN_LEADS_KEY must be the same value as CRM_SYNC_KEY in the CMS service's variables.
# Leave both empty to switch this off.
BLUVEN_LEADS_URL=https://cms.bluven.com.au/api/crm/leads
BLUVEN_LEADS_KEY=
# Optional, first start only: also take over leads created since this time, as history
# (no notifications, not in the pool). Example: 2026-07-01T00:00:00+10:00
BLUVEN_LEADS_SINCE=

# Notification emails (optional). The in-app notifications always work.
# Either through the website's mail relay (works where outgoing SMTP is blocked):
MAIL_RELAY_URL=
MAIL_RELAY_KEY=
# or directly by SMTP. Zoho (Australia) example:
#   smtps://crm%40bluven.com.au:APP_PASSWORD@smtp.zoho.com.au:465
SMTP_URL=
MAIL_FROM=Bluven CRM <crm@bluven.com.au>

# Customer e-mail through Zoho Mail (optional). See Administration > Email in the CRM for the steps.
# The redirect address to register in Zoho is https://<CRM_DOMAIN>/api/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# AI assistant (optional). A key for Anthropic's API; see Administration > AI assistant in the CRM.
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5-5

# Pylon (optional). See Administration > Pylon in the CRM for the steps.
# The API token is enough: the worker reads Pylon's events every minute.
PYLON_API_TOKEN=
# Optional: the secret of a webhook destination, for events to arrive within seconds.
PYLON_WEBHOOK_SECRET=
