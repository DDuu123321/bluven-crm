# Copy to ".env" next to docker-compose.yml on the server and fill in the values.
# Never commit the filled-in file.

# The address people will use, without https://. Its DNS record must point at this server
# before the first start so that the HTTPS certificate can be issued.
CRM_DOMAIN=crm.example.com.au

# Database password. Letters and digits only, because it is used inside a URL.
# Generate one with:  openssl rand -hex 24
POSTGRES_PASSWORD=

# Business time zone for dates on screen and for date-only fields.
APP_TIMEZONE=Australia/Sydney

# Largest single file that can be uploaded, in megabytes.
MAX_UPLOAD_MB=500

# First administrator. Created on the first start only, when no user exists yet.
# You will be asked to choose a new password at first sign-in.
SEED_ADMIN_EMAIL=
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=

# Outgoing notification emails (optional). Leave empty to switch them off.
# Zoho (Australia) example:  smtps://crm%40yourdomain.com.au:APP_PASSWORD@smtp.zoho.com.au:465
SMTP_URL=
MAIL_FROM=Bluven CRM <crm@yourdomain.com.au>

# Pylon (optional). See Settings > Pylon in the CRM for the steps.
PYLON_API_TOKEN=
PYLON_WEBHOOK_SECRET=
