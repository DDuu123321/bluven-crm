# Terminates HTTPS for the CRM and forwards everything to the web container.
# Caddy obtains and renews the certificate on its own once CRM_DOMAIN points at this server.
{$CRM_DOMAIN} {
	encode zstd gzip

	# A little above the application's own upload limit (MAX_UPLOAD_MB, default 500).
	request_body {
		max_size 600MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy web:3000 {
		# Large uploads are streamed to disk by the application; do not buffer them here.
		flush_interval -1
	}
}
