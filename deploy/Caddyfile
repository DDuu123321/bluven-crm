# Terminates HTTPS for the CRM and forwards everything to the web container.
# Caddy obtains and renews the certificate on its own once CRM_DOMAIN points at this server.
{$CRM_DOMAIN} {
	encode zstd gzip

	# A little above the application's own upload limit (MAX_UPLOAD_MB, default 500).
	request_body {
		max_size 600MB
	}

	# The endpoints other systems call take small JSON bodies only. The application enforces its
	# own, tighter limits; this keeps oversized requests from reaching it at all.
	@machine path /api/intake/* /api/webhooks/*
	request_body @machine {
		max_size 2MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}

	reverse_proxy web:3000 {
		# Large uploads are streamed to disk by the application; do not buffer them here.
		flush_interval -1

		# The application reads the visitor's address from this header (sign-in limits, audit
		# log). It is set here, so a value sent by the visitor never gets through.
		header_up X-Real-IP {remote_host}
	}
}
